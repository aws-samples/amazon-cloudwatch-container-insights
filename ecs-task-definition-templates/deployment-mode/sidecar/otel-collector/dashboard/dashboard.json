{
  "start": "-PT3H",
  "periodOverride": "inherit",
  "widgets": [
    {
      "type": "text",
      "properties": {
        "markdown": "# Amazon ECS metrics (PromQL)\nMetrics from the `awsecscontainermetrics` receiver (`collector-ecs-metrics.yaml`, 60s collection). **Filters are regexes** (default `.*`; e.g. `checkout|payments`). Container name applies to container panels only. CPU shown in vCPU (ECS CPU units / 1024)."
      },
      "x": 0,
      "y": 0,
      "width": 24,
      "height": 2
    },
    {
      "type": "text",
      "properties": {
        "markdown": "## Cluster overview",
        "background": "transparent"
      },
      "x": 0,
      "y": 2,
      "width": 24,
      "height": 1
    },
    {
      "type": "chart",
      "properties": {
        "view": "number",
        "title": "Running tasks (RunningTaskCount)",
        "region": "us-west-2",
        "data": {
          "queries": [
            {
              "id": "a",
              "type": "cloudwatch-metrics",
              "language": "PromQL",
              "query": "count(count by (\"@resource.aws.ecs.task.id\") ({\"ecs.task.memory.utilized\", \"@resource.aws.ecs.cluster.name\"=~\"VAR_CLUSTER\", \"@resource.aws.ecs.service.name\"=~\"VAR_SERVICE\", \"@resource.aws.ecs.task.family\"=~\"VAR_FAMILY\", \"@resource.aws.ecs.task.launch_type\"=~\"VAR_LAUNCH\"}))",
              "step": 60
            }
          ]
        },
        "plotOptions": {
          "legend": {
            "position": "bottom",
            "show": false
          },
          "style": {
            "numberOptions": {
              "sparkline": true,
              "truncate": true
            }
          }
        }
      },
      "x": 0,
      "y": 3,
      "width": 4,
      "height": 4
    },
    {
      "type": "chart",
      "properties": {
